# Copiar este archivo a .env.local (NUNCA subir .env.local al repo) y completar
# con los datos del proyecto de Supabase (Project Settings > API).

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Solo para uso en el servidor (migraciones, tareas admin). No exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Para el correo de "olvidé mi PIN" del portal del cliente (resend.com — plan
# gratis alcanza de sobra). API key desde Resend > API Keys.
RESEND_API_KEY=
# Opcional: sin dominio propio verificado en Resend, se usa por defecto su
# remitente de prueba (onboarding@resend.dev), que igual entrega el correo.
RESEND_FROM_EMAIL=
